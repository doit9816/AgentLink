{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentLink",
  "version": "0.1.3",
  "identifier": "com.cmscloud.agentlink",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentLink",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBMkU2RDBEMDZEQkJGM0QKUldROXY5c0dEVzB1aXJWNk0wS0pzRDZ3ditCVkw5ZS9aeEh1QUJSaEhhVSt0NmRQTDNyNHg5U04K",
      "endpoints": [
        "https://github.com/doit9816/AgentLink/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
